# Official CryptoJobsList JSON API key (optional if you scrape with cookies).
# Get one at https://cryptojobslist.com/api-access
CJL_API_KEY=

# Scraping Cloudflare: paste cf_clearance from DevTools → Application → Cookies
# on cryptojobslist.com (or the full Cookie header as CJL_COOKIE).
# These expire — refresh when you see 403 again.
CF_CLEARANCE=
# CJL_COOKIE=_ga=...; cf_clearance=...
CJL_NEXT_BUILD_ID=4UyKDg-aO127lMM1fuvxe
# How often the background scraper refreshes the local catalog (ms). Default 30 minutes.
CJL_SCRAPE_INTERVAL_MS=1800000

# Admin inbox login (defaults shown). Only this account can view /applications.
ADMIN_EMAIL=admin@cryptojobslist.local
ADMIN_PASSWORD=admin123

# Telegram visit alerts. Create a bot with @BotFather, add it as an admin of your channel,
# then put the bot token and channel chat id here (channels are often -100…).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
